# ===================== n8n core =====================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ===================== Postgres (n8n + app DB) =====================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me

# ===================== Trend Discovery (Step 1) — all free, no keys cost money =====================
NEWSAPI_KEY=                 # newsapi.org (free tier: 100 req/day)
YOUTUBE_API_KEY=             # YouTube Data API v3 (free quota: 10k units/day)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=           # Product Hunt GraphQL API developer token (free)
GITHUB_TOKEN=                # GitHub REST API — trending repos search (free, higher rate limit with token)
HN_ALGOLIA_BASE=https://hn.algolia.com/api/v1   # Hacker News via Algolia (free, no key needed)
# Google Trends (SerpAPI) intentionally dropped — it's a paid API with no equivalent free key-based
# alternative; the other 6 sources above already cover trend discovery at zero cost.

# ===================== Content Generation (Steps 2-9) — Gemini free tier, $0/call =====================
GEMINI_API_KEY=               # console: aistudio.google.com/apikey (free, no self-hosting needed)
GEMINI_MODEL=gemini-2.0-flash # swap to a newer/larger Gemini model here if you want different
                               # quality/latency/rate-limit tradeoffs — every call reads this env var,
                               # no workflow JSON edits needed to change models.

# ===================== Storage / Databases (Step 10) — all free tiers =====================
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
NOTION_DATABASE_ID_TRENDS=
NOTION_DATABASE_ID_PRODUCTS=
NOTION_DATABASE_ID_CONTENT=
NOTION_DATABASE_ID_REPORTS=
OUTPUT_DIR=/home/node/output      # local mount for Markdown/JSON file outputs

# ===================== Notifications — all free =====================
DISCORD_WEBHOOK_URL=
ALERT_EMAIL=you@example.com
SLACK_WEBHOOK_URL=

# ===================== YouTube Shorts Pipeline (workflow 05) — $0 stack =====================
# YouTube OAuth2 credentials are configured directly in n8n's YouTube credential,
# NOT via env var — see README section 9 for the Google Cloud Console walkthrough.
# The YouTube Data API itself is free (quota-limited); only the OAuth setup needs a Google account.
YT_CHANNEL_ID=

PEXELS_API_KEY=               # stock footage — the ONLY video source now (no paid AI video gen)
PIXABAY_API_KEY=              # optional second stock source if a Pexels search comes up empty

RENDER_DIR=/home/node/render  # shared volume where FFmpeg assembles each video (see docker-compose.yml)
BG_MUSIC_URL=https://your-cdn-or-freesound-track/royalty-free-track.mp3
# Source royalty-free tracks from the YouTube Audio Library, Pixabay Music, or freesound.org (all free).
# No TTS/voiceover service is configured — Shorts are caption-only (on-screen text + music). See
# README section 9a if you want to add narration back in.
