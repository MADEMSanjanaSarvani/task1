# ===================== n8n core =====================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ===================== Postgres (n8n + app DB) =====================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me

# ===================== Trend Discovery (Step 1) =====================
SERPAPI_KEY=                 # Google Trends via SerpAPI (paid) — free alt: pytrends microservice
NEWSAPI_KEY=                 # newsapi.org (free tier: 100 req/day) — free alt: GNews / Google News RSS
YOUTUBE_API_KEY=             # YouTube Data API v3 (free quota: 10k units/day)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=           # Product Hunt GraphQL API developer token (free)
GITHUB_TOKEN=                # GitHub REST API — trending repos search (free, higher rate limit with token)
HN_ALGOLIA_BASE=https://hn.algolia.com/api/v1   # Hacker News via Algolia (free, no key needed)

# ===================== Content Generation (Step 4-7) =====================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_RESEARCH_MODEL=gpt-4.1        # free alt: local Llama-3/Mistral via Ollama
OPENAI_TEMPERATURE_CREATIVE=0.7
OPENAI_TEMPERATURE_FACTUAL=0.2

# ===================== Storage / Databases (Step 10) =====================
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
NOTION_DATABASE_ID_TRENDS=
NOTION_DATABASE_ID_PRODUCTS=
NOTION_DATABASE_ID_CONTENT=
NOTION_DATABASE_ID_REPORTS=
OUTPUT_DIR=/home/node/output      # local mount for Markdown/JSON file outputs

# ===================== Notifications =====================
DISCORD_WEBHOOK_URL=
ALERT_EMAIL=you@example.com
SLACK_WEBHOOK_URL=
