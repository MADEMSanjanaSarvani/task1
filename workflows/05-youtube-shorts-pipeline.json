      "parameters": {
        "jsCode": "// Fires once after Split Into Scenes' loop finishes; collects every scene the loop processed.\nconst scenes = $items('Build FFmpeg Process Command').map(i => i.json);\nif (!scenes.length) throw new Error('No scenes were processed - nothing to concatenate');\nconst first = scenes[0];\nconst listContent = scenes.map(s => `file 'scene_${s.index}_processed.mp4'`).join('\\n');\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(listContent, 'utf8'), 'concat_list.txt', 'text/plain');\nreturn [{ json: { run_id: first.run_id, title: first.title, topic_id: first.topic_id, full_script: first.full_script, render_dir: first.render_dir, scene_count: scenes.length }, binary: { data: binary } }];\n"
      },
