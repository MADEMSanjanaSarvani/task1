        "jsCode": "// Automated QC: duration and aspect ratio sanity checks (aspect enforced by Shotstack output.size).\nconst render = $input.first().json.response;\nconst durationOk = render.data && render.data.duration >= 20 && render.data.duration <= 60;\nconst issues = [];\nif (!durationOk) issues.push('duration_out_of_range');\nreturn [{ json: { video_url: render.url, duration: render.data?.duration, qc_passed: issues.length === 0, qc_issues: issues } }];\n"
