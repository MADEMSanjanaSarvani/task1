    },
    {
      "parameters": {
        "jsCode": "const scene = $input.first().json;\nconst font = $env.RENDER_FONT_PATH || '/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf';\nconst base = scene.render_dir;\nconst idx = scene.index;\nconst cmd = `mkdir -p \"${base}\" && ffmpeg -y -i \"${base}/scene_${idx}_raw.mp4\" -t ${scene.duration} `\n  + `-vf \"scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,fps=30,`\n  + `drawtext=fontfile=${font}:textfile=${base}/scene_${idx}_caption.txt:fontcolor=white:fontsize=54:`\n  + `x=(w-text_w)/2:y=h-380:box=1:boxcolor=black@0.55:boxborderw=24\" -an -c:v libx264 -preset veryfast `\n  + `-pix_fmt yuv420p \"${base}/scene_${idx}_processed.mp4\"`;\nreturn [{ json: { ...scene, cmd } }];\n"
      },
