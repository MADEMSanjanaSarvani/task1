      "parameters": {
        "jsCode": "// Reattach scene metadata (lost by the HTTP node's response body) and build the caption text-file binary\n// alongside the downloaded clip binary, so both can be written to disk before FFmpeg runs.\nconst scene = $('Merge Scene Media').item.json;\nconst runId = String(scene.run_id).replace(/[^a-zA-Z0-9._-]/g, '');\nconst idx = Number(scene.index);\nif (!runId || !Number.isInteger(idx) || idx < 0 || idx > 999) throw new Error('unsafe run_id/index: ' + scene.run_id + '/' + scene.index);\nconst dir = $env.RENDER_DIR || '/home/node/render';\nconst renderDir = `${dir}/${runId}`;\nconst captionBinary = await this.helpers.prepareBinaryData(Buffer.from(scene.text, 'utf8'), `scene_${idx}_caption.txt`, 'text/plain');\nreturn [{ json: { ...scene, run_id: runId, index: idx, render_dir: renderDir }, binary: { clip: $input.first().binary.data, caption: captionBinary } }];\n"
      },
      "id": "code-build-scene-files",
