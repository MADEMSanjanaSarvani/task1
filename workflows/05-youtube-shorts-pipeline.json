    {
      "parameters": {
        "jsCode": "// Split full_script into sentences and build a cinematic 9:16 video prompt per sentence.\nconst script = $('Attach Fact-Check Result').first().json;\nconst sentences = script.full_script.split(/(?<=[.!?])\\s+/).filter(Boolean);\nconst scenes = sentences.map((s, i) => ({\n  index: i,\n  text: s,\n  video_prompt: `Cinematic vertical 9:16 shot illustrating: \"${s}\". Modern, energetic, laptop/phone/business b-roll style, shallow depth of field, subtle camera movement, photorealistic, no text overlays.`,\n  image_fallback_prompt: `Vertical 9:16 photorealistic still illustrating: \"${s}\"`\n}));\nreturn [{ json: { title: script.title, topic_id: script.topic_id, full_script: script.full_script, scenes } }];\n"
      },
      "id": "code-scene-prompts",
      "name": "Generate Scene Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
