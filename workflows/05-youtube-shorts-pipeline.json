    },
    {
      "parameters": {
        "jsCode": "// Build a Shotstack edit timeline: captions, transitions, Ken-Burns zoom, narration sync,\n// and background-music track. Output 1080x1920 MP4.\nconst scenes = $items('Merge Scene Media').map(i => i.json);\nconst scriptData = $('Generate Scene Prompts').first().json;\nconst audioUrl = $('Generate Voiceover (ElevenLabs)').first().json.url || $('Generate Voiceover (ElevenLabs)').first().binary?.data?.fileName;\nconst clipLen = 4;\nconst clips = scenes.map((s, i) => ({\n  asset: { type: 'video', src: s.video_url || s.image_fallback_url },\n  start: i * clipLen,\n  length: clipLen,\n  transition: { in: 'fade', out: 'fade' },\n  effect: 'zoomIn'\n}));\nconst captionClips = scenes.map((s, i) => ({\n  asset: { type: 'html', html: `<p>${s.text}</p>`, css: 'p { color:#fff; font-size:44px; text-align:center; font-family:sans-serif; }' },\n  start: i * clipLen,\n  length: clipLen\n}));\nreturn [{ json: {\n  topic_id: scriptData.topic_id,\n  title: scriptData.title,\n  full_script: scriptData.full_script,\n  timeline: {\n    background: '#000000',\n    tracks: [ { clips: captionClips }, { clips }, { clips: [ { asset: { type: 'audio', src: audioUrl }, start: 0, length: scenes.length * clipLen } ] }, { clips: [ { asset: { type: 'audio', src: '={{$env.BG_MUSIC_URL}}' }, start: 0, length: scenes.length * clipLen, volume: 0.15 } ] } ]\n  },\n  output: { format: 'mp4', size: { width: 1080, height: 1920 } }\n} }];\n"
      },
      "id": "code-build-timeline",
      "name": "Build Shotstack Timeline",
      "type": "n8n-nodes-base.code",
