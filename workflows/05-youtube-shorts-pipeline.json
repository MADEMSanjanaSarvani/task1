      "parameters": {
        "jsCode": "// Map Pexels' response shape onto the same {video_url, text} shape the AI video gen branch produces.\nconst d = $input.first().json;\nconst sceneText = $('Split Into Scenes').item.json.text || '';\nconst file = (d.videos && d.videos[0] && d.videos[0].video_files && d.videos[0].video_files.find(f => f.quality === 'hd')) || (d.videos && d.videos[0] && d.videos[0].video_files && d.videos[0].video_files[0]);\nreturn [{ json: { text: sceneText, video_url: file ? file.link : null, image_fallback_url: file ? file.link : null } }];\n"
      },
      "id": "code-normalize-stock",
