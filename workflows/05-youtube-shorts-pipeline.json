      "parameters": {
        "jsCode": "const script = $input.first().json;\nconst runId = $('Get Next Candidate Topic').first().json.run_id;\nconst sentences = script.full_script.split(/(?<=[.!?])\\s+/).filter(Boolean).slice(0, 10);\nconst STOPWORDS = new Set(['the','a','an','is','are','to','of','in','on','for','and','with','your','you','this','that','it','as','at','by','be','can','will','how','what','why']);\nreturn sentences.map((s, i) => {\n  const words = s.replace(/[^a-zA-Z0-9 ]/g, '').split(/\\s+/).filter(w => w && !STOPWORDS.has(w.toLowerCase()));\n  const search_query = (words.slice(0, 4).join(' ') || 'business technology').trim();\n  return { json: { run_id: runId, title: script.title, topic_id: script.topic_id, full_script: script.full_script, index: i, text: s, search_query, duration: 4 } };\n});\n"
      },
