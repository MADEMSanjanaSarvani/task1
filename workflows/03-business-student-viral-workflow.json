            "demand_score": "={{$json.demand_score}}", "profitability_score": "={{$json.profitability_score}}",
            "difficulty_score": "={{$json.difficulty_score}}", "seo_score": "={{$json.seo_score}}",
            "automation_score": "={{$json.automation_score}}", "longterm_score": "={{$json.longterm_score}}"
          }
        }
      },
      "id": "postgres-save-viral",
      "name": "Save Viral Trends (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [ -900, 160 ],
      "credentials": { "postgres": { "id": "postgres-creds", "name": "Postgres account" } },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3
    },
    {
