{
  "name": "AI Content Automation - 02 Content Generation",
  "nodes": [
    {
      "parameters": {},
      "id": "execute-trigger",
      "name": "When Called by Trend Research",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -2200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "schema": {
          "value": "public"
        },
        "table": {
          "value": "trend_topics"
        },
        "sort": {
          "values": [
            {
              "column": "overall_score",
              "direction": "DESC"
            }
          ]
        },
        "limit": 1,
        "where": {
          "values": [
            {
              "column": "status",
              "condition": "equal",
              "value": "candidate"
            }
          ]
        },
        "options": {}
      },
      "id": "postgres-get-top-topic",
      "name": "Get Top Topic (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -1980,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-creds",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OLLAMA_BASE_URL || 'http://ollama:11434'}}/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OLLAMA_MODEL || 'llama3.1:8b', stream: false, format: 'json', options: { temperature: 0.7 }, messages: [ { role: 'system', content: \"You are an expert SEO Content Researcher and Blog Writer. Write a factually accurate, SEO-optimized blog article of at least 1500 words about the given trending opportunity. Return strict JSON: {\\\"title\\\": string, \\\"meta_description\\\": string, \\\"seo_keywords\\\": [string], \\\"introduction\\\": string, \\\"main_content\\\": string (markdown with H2/H3 headers, at least 1200 words), \\\"conclusion\\\": string, \\\"faqs\\\": [{\\\"question\\\": string, \\\"answer\\\": string}] (at least 5)}. Avoid duplicate or outdated information, include actionable recommendations, and prioritize high-value monetizable opportunities.\" }, { role: 'user', content: `Write the blog article for this trending opportunity:\\nTitle: ${$json.title}\\nCategory: ${$json.category}\\nScores: demand ${$json.demand_score}, profitability ${$json.profitability_score}, competition ${$json.competition_score}, SEO ${$json.seo_score}` } ] }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "openai-blog",
      "name": "Generate SEO Blog Article (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1760,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const topic = $('Get Top Topic (Postgres)').first().json;\nconst raw = $input.first().json.message?.content || $input.first().json.content;\nconst blog = JSON.parse(raw);\nconst wordCount = (blog.main_content || '').split(/\\s+/).filter(Boolean).length + (blog.introduction || '').split(/\\s+/).filter(Boolean).length + (blog.conclusion || '').split(/\\s+/).filter(Boolean).length;\nreturn [{ json: { run_id: topic.run_id, topic_id: topic.id, topic_title: topic.title, word_count: wordCount, ...blog } }];\n"
      },
      "id": "code-parse-blog",
      "name": "Parse & Validate Blog (>=1500 words)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1540,
        0
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "value": "public"
        },
        "table": {
          "value": "blog_posts"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{$json.run_id}}",
            "topic_id": "={{$json.topic_id}}",
            "title": "={{$json.title}}",
            "meta_description": "={{$json.meta_description}}",
            "seo_keywords": "={{$json.seo_keywords}}",
            "introduction": "={{$json.introduction}}",
            "main_content": "={{$json.main_content}}",
            "conclusion": "={{$json.conclusion}}",
            "faqs": "={{JSON.stringify($json.faqs)}}",
            "word_count": "={{$json.word_count}}"
          }
        },
        "options": {
          "outputColumns": [
            "id"
          ]
        }
      },
      "id": "postgres-save-blog",
      "name": "Save Blog Post (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -1320,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-creds",
          "name": "Postgres account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json;\nconst md = `# ${b.title}\\n\\n_${b.meta_description}_\\n\\n${b.introduction}\\n\\n${b.main_content}\\n\\n${b.conclusion}\\n\\n## FAQs\\n\\n` + (b.faqs || []).map(f => `**${f.question}**\\n${f.answer}`).join('\\n\\n');\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(md, 'utf8'), `${b.run_id}-blog.md`, 'text/markdown');\nreturn [{ json: b, binary: { data: binary } }];\n"
      },
      "id": "code-build-blog-markdown",
      "name": "Build Blog Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1100,
        -260
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{$env.OUTPUT_DIR || '/home/node/output'}}/blogs/{{$json.run_id}}-blog.md",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "write-blog-markdown",
      "name": "Write Blog Markdown File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        -880,
        -260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OLLAMA_BASE_URL || 'http://ollama:11434'}}/api/chat",
