      "parameters": { "mode": "append", "numberInputs": 13, "options": {} },
      "id": "merge-report-data",
      "name": "Merge All Report Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [ -2140, -40 ]
    },
    {
      "parameters": {
        "jsCode": "// Regroup the 13 merged branches back into named buckets using node-reference lookups,\n// since Merge(append) flattens everything into one list.\nconst pick = (name) => { try { return $(name).all().map(i => i.json); } catch (e) { return []; } };\nconst runId = (pick('Get Top 10 Opportunities')[0] || {}).run_id || 'unknown-run';\nconst bundle = {\n  run_id: runId,\n  report_date: new Date().toISOString().slice(0, 10),\n  top_opportunities: pick('Get Top 10 Opportunities'),\n  top_digital_products: pick('Get Top 10 Digital Products'),\n  top_freelancing_niches: pick('Get Top 10 Freelancing Niches'),\n  top_ai_tools: pick('Get Top AI Tools'),\n  top_startup_ideas: pick('Get Top Startup Ideas'),\n  top_trending_topics: pick('Get Top Trending Topics'),\n  best_side_hustles: pick('Get Best Side Hustles'),\n  highest_revenue_opportunity: pick('Get Highest Revenue Opportunity')[0] || {},\n  lowest_competition_opportunity: pick('Get Lowest Competition Opportunity')[0] || {},\n  latest_blog: pick('Get Latest Blog Post')[0] || {},\n  latest_social: pick('Get Latest Social Content')[0] || {},\n  latest_youtube: pick('Get Latest YouTube Content')[0] || {},\n  latest_newsletter: pick('Get Latest Newsletter')[0] || {}\n};\nreturn [{ json: bundle }];\n"
      },
      "id": "code-assemble-bundle",
      "name": "Assemble Report Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ -1920, -40 ]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "={{$env.OPENAI_MODEL || 'gpt-4.1'}}",
        "options": { "temperature": 0.5 },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Digital Product Consultant writing the closing section of a daily opportunities report. Write a concise, prioritized, actionable 'Recommended Action Plan' (150-250 words) telling the reader exactly what to do today, this week, and this month, based on the highest demand + lowest competition + highest monetization opportunities provided. Plain text, no JSON."
            },
            {
              "role": "user",
              "content": "=Top opportunities: {{ JSON.stringify($json.top_opportunities.slice(0,5).map(o=>o.title)) }}\\nHighest revenue idea: {{ $json.highest_revenue_opportunity.idea_name }}\\nLowest competition opportunity: {{ $json.lowest_competition_opportunity.title }}"
            }
          ]
        }
      },
      "id": "openai-action-plan",
      "name": "Generate Recommended Action Plan (OpenAI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [ -1700, -40 ],
      "credentials": { "openAiApi": { "id": "openai-creds", "name": "OpenAI account" } },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "const bundle = $('Assemble Report Bundle').first().json;\nconst plan = $input.first().json.message?.content || $input.first().json.content || $input.first().json.text;\nconst r = { ...bundle, recommended_action_plan: plan };\n\nconst list = (arr, fmt) => (arr || []).map((x, i) => `${i + 1}. ${fmt(x)}`).join('\\n');\nconst md = `# Daily AI Content & Opportunity Report — ${r.report_date}\\n\\n` +\n`## 1. Top 10 Opportunities\\n${list(r.top_opportunities, o => `**${o.title}** (${o.category}) — score ${o.overall_score}`)}\\n\\n` +\n`## 2. Top 10 Digital Products\\n${list(r.top_digital_products, p => `**${p.product_name}** — $${p.estimated_price_usd}, ${p.best_platform}`)}\\n\\n` +\n`## 3. Top 10 Freelancing Niches\\n${list(r.top_freelancing_niches, f => `**${f.skill_required}** — ${f.income_potential} on ${f.best_platform}`)}\\n\\n` +\n`## 4. Top AI Tools\\n${list(r.top_ai_tools, t => `**${t.title}**`)}\\n\\n` +\n`## 5. Top Startup Ideas\\n${list(r.top_startup_ideas, s => `**${s.idea_name}** — ${s.solution}`)}\\n\\n` +\n`## 6. Top Trending Topics\\n${list(r.top_trending_topics, t => `**${t.trend_name}** — virality ${t.virality_score}`)}\\n\\n` +\n`## 7. Best Side Hustles\\n${list(r.best_side_hustles, h => `**${h.title}**`)}\\n\\n` +\n`## 8. Highest Revenue Opportunity\\n**${r.highest_revenue_opportunity.idea_name || 'N/A'}** — up to $${r.highest_revenue_opportunity.monthly_revenue_potential_usd || 0}/mo\\n\\n` +\n`## 9. Lowest Competition Opportunity\\n**${r.lowest_competition_opportunity.title || 'N/A'}** — competition score ${r.lowest_competition_opportunity.competition_score || 'N/A'}\\n\\n` +\n`## 10. Recommended Action Plan\\n${r.recommended_action_plan}\\n`;\n\nreturn [{ json: { ...r, markdown_report: md } }];\n"
      },
      "id": "code-build-report",
      "name": "Build Daily Report (Markdown + JSON)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ -1480, -40 ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": { "value": "public" },
        "table": { "value": "daily_reports" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{$json.run_id}}", "report_date": "={{$json.report_date}}",
            "top_opportunities": "={{JSON.stringify($json.top_opportunities)}}",
            "top_digital_products": "={{JSON.stringify($json.top_digital_products)}}",
            "top_freelancing_niches": "={{JSON.stringify($json.top_freelancing_niches)}}",
            "top_ai_tools": "={{JSON.stringify($json.top_ai_tools)}}",
            "top_startup_ideas": "={{JSON.stringify($json.top_startup_ideas)}}",
            "top_trending_topics": "={{JSON.stringify($json.top_trending_topics)}}",
            "best_side_hustles": "={{JSON.stringify($json.best_side_hustles)}}",
            "highest_revenue_opportunity": "={{JSON.stringify($json.highest_revenue_opportunity)}}",
            "lowest_competition_opportunity": "={{JSON.stringify($json.lowest_competition_opportunity)}}",
            "recommended_action_plan": "={{$json.recommended_action_plan}}",
            "markdown_report": "={{$json.markdown_report}}"
          }
        }
      },
      "id": "postgres-save-report",
      "name": "Save Daily Report (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [ -1260, -40 ],
      "credentials": { "postgres": { "id": "postgres-creds", "name": "Postgres account" } },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst md = r.markdown_report;\nconst binaryMd = await this.helpers.prepareBinaryData(Buffer.from(md, 'utf8'), `${r.run_id}-daily-report.md`, 'text/markdown');\nconst binaryJson = await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(r, null, 2), 'utf8'), `${r.run_id}-daily-report.json`, 'application/json');\nreturn [{ json: r, binary: { markdown: binaryMd, json: binaryJson } }];\n"
      },
      "id": "code-build-report-files",
      "name": "Build Report Files (MD + JSON)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ -1040, -40 ]
